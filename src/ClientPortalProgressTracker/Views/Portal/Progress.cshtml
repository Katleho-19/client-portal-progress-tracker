@model ClientPortalProgressTracker.Models.ViewModels.PortalViewModel
@using ClientPortalProgressTracker.Models.Entities
@{
    Layout = "_PortalLayout";
    var p = Model.Project;
    var isPaid = p.Status == ProjectStatus.PaidInFull;
    var canPayBalance = p.Status == ProjectStatus.CompletedUnpaid && Model.AmountDueNow > 0;
    ViewData["Title"] = p.Title;
    var firstOpenIndex = Model.Milestones.FindIndex(m => m.Status != MilestoneStatus.Completed);
}
<partial name="_PortalHeader" model="Model" />

<div class="portal-content">
    <partial name="_PortalAlerts" />

    @if (isPaid)
    {
        <div class="portal-alert portal-alert-success"><strong>Paid in full</strong> &middot; Read-only archive.</div>
    }

    <div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="portal-title">@p.Title</h1>
            @if (isPaid)
            {
                <span class="status-pill status-paid">Paid</span>
            }
            else if (p.Status == ProjectStatus.CompletedUnpaid)
            {
                <span class="status-pill status-awaiting">Balance due</span>
            }
            else
            {
                <span class="status-pill status-active">Active</span>
            }
        </div>
        <p class="portal-meta">Ref @p.ReferenceCode</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(p.MessageToClient))
    {
        <section class="portal-card">
            <h2>Note from @Model.Freelancer.FullName</h2>
            <p class="mb-0" style="white-space: pre-line;">@p.MessageToClient</p>
        </section>
    }

    <section class="portal-card">
        <div class="d-flex justify-content-between mb-2">
            <strong>Overall progress</strong>
            <strong class="@(isPaid ? "text-success" : "text-brand")">@Model.ProgressPercent%</strong>
        </div>
        <div class="portal-bar"><div class="portal-bar-fill @(isPaid ? "is-green" : "")" style="width:@(Model.ProgressPercent)%"></div></div>
        <div class="portal-meta mt-2">@Model.CompletedCount of @Model.Milestones.Count milestones complete</div>
    </section>

    <section class="portal-card">
        <h2>Milestones</h2>
        @for (var i = 0; i < Model.Milestones.Count; i++)
        {
            var ms = Model.Milestones[i];
            var state = ms.Status == MilestoneStatus.Completed ? "done"
            : (ms.Status == MilestoneStatus.InProgress || i == firstOpenIndex ? "doing" : "todo");
            var label = ms.Status == MilestoneStatus.Completed ? "Completed"
            : (ms.Status == MilestoneStatus.InProgress ? "In progress" : "Pending");
            <div class="portal-step">
                <div class="portal-rail">
                    <div class="portal-dot @state">
                        @if (state == "done")
                        {
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        }
                    </div>
                    @if (i < Model.Milestones.Count - 1)
                    {
                        <div class="portal-line @(state == "done" ? "done" : "")"></div>
                    }
                </div>
                <div class="portal-step-text">
                    <div class="portal-ms-title">@ms.Title</div>
                    <div class="portal-ms-desc @(ms.Status == MilestoneStatus.InProgress ? "text-brand" : "")">@label@(ms.CompletedAt.HasValue ? " · " + ms.CompletedAt.Value.ToString("dd MMM yyyy") : "")</div>
                </div>
            </div>
        }
    </section>

    @if (!isPaid)
    {
        <section class="portal-card">
            <h2>Payments</h2>
            <div class="portal-kv"><span>Total</span><strong>R @p.TotalAmount.ToString("N2")</strong></div>
            <div class="portal-kv"><span>Paid</span><strong class="text-success">R @p.AmountPaid.ToString("N2")</strong></div>
            <div class="portal-kv"><span>Balance due</span><strong>R @Model.BalanceDue.ToString("N2")</strong></div>

            @if (canPayBalance)
            {
                <a asp-controller="Portal" asp-action="Pay" asp-route-slug="@p.PortalSlug" class="btn btn-figma-primary w-100 mt-3">Pay final balance</a>
            }
            else
            {
                var targetMilestone = Model.Milestones.Count > 1
                ? Model.Milestones[Model.Milestones.Count - 2].Title
                : (Model.Milestones.LastOrDefault()?.Title ?? "final");
                <button type="button" class="btn btn-secondary w-100 mt-3" disabled>Pay final balance</button>
                <p class="portal-fine mt-2 mb-0">Available once the @targetMilestone milestone is complete.</p>
            }
        </section>
    }


    @if (Model.Signature != null || Model.Transactions.Any(t => t.Status == TransactionStatus.Success))
    {
        <section class="portal-card">
            <h2>@(isPaid ? "Receipts & documents" : "Documents")</h2>

            @if (Model.Signature != null)
            {
                <a asp-controller="Portal" asp-action="QuotePdf" asp-route-slug="@p.PortalSlug"
                   class="d-flex justify-content-between align-items-center p-3 mb-2 border rounded text-decoration-none text-dark">
                    <div>
                        <div class="fw-semibold">Signed quote (PDF)</div>
                        <div class="portal-meta">Signed @Model.Signature.SignedAt.ToString("dd MMM yyyy")</div>
                    </div>
                    <span class="btn btn-sm btn-light border text-primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    </span>
                </a>
            }

            @foreach (var tx in Model.Transactions.Where(t => t.Status == TransactionStatus.Success))
            {
                var typeLabel = tx.PaymentType == PaymentType.Deposit ? "Deposit receipt"
                : (tx.PaymentType == PaymentType.FinalBalance ? "Final balance receipt" : "Full payment receipt");
                <div class="d-flex justify-content-between align-items-center p-3 mb-2 border rounded">
                    <div>
                        <div class="fw-semibold">@typeLabel</div>
                        <div class="portal-meta">
                            R @tx.Amount.ToString("N2") &middot; @((tx.PaidAt ?? tx.CreatedAt).ToString("dd MMM yyyy"))
                            @if (!string.IsNullOrWhiteSpace(tx.PopFilePath))
                            {
                                <span> &middot; <a asp-controller="Portal" asp-action="DownloadPop" asp-route-slug="@p.PortalSlug" asp-route-transactionId="@tx.Id" target="_blank">View POP</a></span>
                            }
                        </div>
                    </div>
                    <a asp-controller="Portal" asp-action="ReceiptPdf" asp-route-slug="@p.PortalSlug" asp-route-transactionId="@tx.Id"
                       class="btn btn-sm btn-light border text-primary" title="Download Receipt PDF">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    </a>
                </div>
            }
        </section>
    }
</div>
