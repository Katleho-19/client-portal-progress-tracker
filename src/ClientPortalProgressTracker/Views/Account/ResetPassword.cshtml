@*Programmer: Katleho Innocent Makhoali*@
@model ClientPortalProgressTracker.Models.ViewModels.ResetPasswordViewModel
@{
    Layout = null;
    bool passwordUpdated = ViewBag.PasswordUpdated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set a new password - KM Web Studio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="hifi-auth-body">
    <div class="auth-split-wrapper">
        <partial name="_AuthBrandPanel" />

        <main class="auth-form-panel">
            <div class="auth-form-container">
                @if (passwordUpdated)
                {
                    <!-- STATE 2: 1d · Password updated -->
                    <div class="status-badge-success">&#10003;</div>
                    <h1 class="h3 fw-bold mb-2">Password updated</h1>
                    <p class="text-muted small mb-4">
                        Your password has been changed. You can now log in with the new password.
                    </p>
                    <a asp-action="Login" class="btn btn-figma-primary text-decoration-none">Go to log in</a>
                }
                else
                {
                    <!-- STATE 1: 1d · Reset password -->
                    <div id="validResetState">
                        <h1 class="h3 fw-bold mb-1">Set a new password</h1>
                        <p class="text-muted small mb-4">Choose a strong password you have not used before.</p>

                        <form asp-action="ResetPassword" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>
                            <input asp-for="AccessToken" type="hidden" id="accessTokenInput" />
                            <input asp-for="RefreshToken" type="hidden" id="refreshTokenInput" />

                            <div class="mb-3">
                                <label asp-for="NewPassword" class="form-label figma-label">New password</label>
                                <input asp-for="NewPassword" id="newPwdInput" class="form-control figma-input" placeholder="Min. 8 characters" autocomplete="new-password" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label figma-label">Confirm new password</label>
                                <input asp-for="ConfirmPassword" class="form-control figma-input" placeholder="Re-enter password" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <ul class="list-unstyled small text-muted mb-4">
                                <li class="mb-2 d-flex align-items-center">
                                    <span class="rule-circle" id="dotLen">&#10003;</span>At least 8 characters
                                </li>
                                <li class="mb-2 d-flex align-items-center">
                                    <span class="rule-circle" id="dotNum">&#10003;</span>Contains a number
                                </li>
                                <li class="d-flex align-items-center">
                                    <span class="rule-circle" id="dotUpper">&#10003;</span>Contains an uppercase letter
                                </li>
                            </ul>

                            <button type="submit" class="btn btn-figma-primary">Update password</button>
                        </form>
                    </div>

                    <!-- STATE 3: 1d · Link expired -->
                    <div id="expiredResetState" class="d-none">
                        <div class="status-badge-expired">&times;</div>
                        <h1 class="h3 fw-bold mb-2">This link has expired</h1>
                        <p class="text-muted small mb-4">
                            Reset links are valid for 60 minutes and can only be used once.
                        </p>
                        <a asp-action="ForgotPassword" class="btn btn-figma-primary text-decoration-none mb-3">Request a new link</a>
                        <div>
                            <a asp-action="Login" class="figma-link d-inline-block mt-1">&larr; Back to log in</a>
                        </div>
                    </div>
                }
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const validEl = document.getElementById("validResetState");
            if (!validEl) return;

            const hashParams = new URLSearchParams(window.location.hash.substring(1));
            const queryParams = new URLSearchParams(window.location.search);
            const at = hashParams.get("access_token");
            const rt = hashParams.get("refresh_token");
            const hasError = hashParams.get("error") || queryParams.get("error");

            if (at && rt) {
                document.getElementById("accessTokenInput").value = at;
                document.getElementById("refreshTokenInput").value = rt;
                history.replaceState(null, "", window.location.pathname);
            } else if (hasError || !document.getElementById("accessTokenInput").value) {
                validEl.classList.add("d-none");
                document.getElementById("expiredResetState").classList.remove("d-none");
            }

            const pwdInput = document.getElementById("newPwdInput");
            if (pwdInput) {
                pwdInput.addEventListener("input", function () {
                    const v = this.value;
                    document.getElementById("dotLen").classList.toggle("met", v.length >= 8);
                    document.getElementById("dotNum").classList.toggle("met", /[0-9]/.test(v));
                    document.getElementById("dotUpper").classList.toggle("met", /[A-Z]/.test(v));
                });
            }
        })();
    </script>
</body>
</html>
