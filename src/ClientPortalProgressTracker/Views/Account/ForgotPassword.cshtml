@*Programmer: Katleho Innocent Makhoali*@
@model ClientPortalProgressTracker.Models.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
    bool linkSent = ViewBag.LinkSent == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot your password? - KM Web Studio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="hifi-auth-body">
    <div class="auth-split-wrapper">
        <partial name="_AuthBrandPanel" />

        <main class="auth-form-panel">
            <div class="auth-form-container">
                @if (!linkSent)
                {
                    <h1 class="h3 fw-bold mb-1">Forgot your password?</h1>
                    <p class="text-muted small mb-4">Enter your email and we will send you a link to reset it.</p>

                    <form asp-action="ForgotPassword" method="post">
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label figma-label">Email</label>
                            <input asp-for="Email" class="form-control figma-input" placeholder="you@business.co.za" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-figma-primary mb-3">Send reset link</button>
                    </form>
                }
                else
                {
                    <div class="inbox-icon-circle">
                        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                            <path d="M3 7l9 6 9-6"></path>
                        </svg>
                    </div>
                    <h1 class="h3 fw-bold mb-2">Check your inbox</h1>
                    <p class="text-muted small mb-4">
                        If an account exists for <strong>@Model.Email</strong>, a reset link is on its way. The link expires in 60 minutes.
                    </p>

                    <form asp-action="ForgotPassword" method="post" class="mb-3">
                        <input asp-for="Email" type="hidden" />
                        <button type="submit" class="btn btn-figma-secondary">Resend email</button>
                    </form>
                }

                <a asp-action="Login" class="figma-link d-inline-block mt-1">&larr; Back to log in</a>
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
